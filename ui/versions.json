   "h": 72,
   "props": {
    "bgColor": "#1e2330",
    "radius": 0
   },
   "children": [
    {
     "id": "nav_dashboard",
     "type": "button",
     "x": 40,
     "y": 14,
     "w": 150,
     "h": 44,
     "action": "nav.dashboard",
     "props": {
      "text": "Dashboard",
      "fontSize": 20,
      "bgColor": "#303748",
      "radius": 8
     }
    },
    {
     "id": "nav_profiles",
     "type": "button",
     "x": 200,
     "y": 14,
     "w": 150,
     "h": 44,
     "action": "nav.profiles",
     "props": {
      "text": "Profiles",
      "fontSize": 20,
      "bgColor": "#303748",
      "radius": 8
     }
    },
    {
     "id": "nav_mods",
     "type": "button",
     "x": 360,
     "y": 14,
     "w": 150,
     "h": 44,
     "action": "nav.mods",
     "props": {
      "text": "Mods",
      "fontSize": 20,
      "bgColor": "#303748",
      "radius": 8
     }
    },
    {
     "id": "nav_versions",
     "type": "button",
     "x": 520,
     "y": 14,
     "w": 150,
     "h": 44,
     "action": "nav.versions",
     "props": {
      "text": "Versions",
      "fontSize": 20,
      "bgColor": "#477cf2",
      "radius": 8
     }
    },
    {
     "id": "nav_settings",
     "type": "button",
     "x": 680,
     "y": 14,
     "w": 150,
     "h": 44,
     "action": "nav.settings",
     "props": {
      "text": "Settings",
      "fontSize": 20,
      "bgColor": "#303748",
      "radius": 8
     }
    },
    {
     "id": "app_title",
     "type": "label",
     "x": 1280,
     "y": 14,
     "w": 280,
     "h": 44,
     "props": {
      "text": "BS VR Manager",
      "fontSize": 24,
      "color": "#477cf2",
      "align": "right"
     }
    }
   ]
  },
  {
   "id": "title",
   "type": "label",
   "x": 40,
   "y": 92,
   "w": 700,
   "h": 46,
   "props": {
    "text": "Versions",
    "fontSize": 32
   }
  },
  {
   "id": "refreshBtn",
   "type": "button",
   "x": 1300,
   "y": 148,
   "w": 260,
   "h": 40,
   "action": "versions.refresh",
   "props": {
    "text": "Refresh catalog",
    "fontSize": 17,
    "bgColor": "#303748",
    "radius": 8
   }
  },
  {
   "id": "versionsList",
   "type": "list",
   "x": 40,
   "y": 196,
   "w": 1520,
   "h": 560,
   "props": {
    "itemHeight": 86,
    "gap": 8,
    "dataKey": "versions.catalog"
   },
   "itemTemplate": {
    "id": "version_row",
    "type": "panel",
    "x": 0,
    "y": 0,
    "w": 1520,
    "h": 86,
    "props": {
     "bgColor": "#232a38",
     "radius": 10
    },
    "children": [
     {
      "id": "row_version",
      "type": "label",
      "x": 20,
      "y": 24,
      "w": 200,
      "h": 38,
      "props": {
       "text": "{version}",
       "fontSize": 26
      }
     },
     {
      "id": "row_status",
      "type": "label",
      "x": 240,
      "y": 28,
      "w": 640,
      "h": 30,
      "props": {
       "text": "{versionStatus}",
       "fontSize": 19,
       "color": "#9aa3b5"
      }
     },
     {
      "id": "row_release",
      "type": "label",
      "x": 900,
      "y": 28,
      "w": 320,
      "h": 30,
      "props": {
       "text": "{releaseDate}",
       "fontSize": 18,
       "color": "#6f7889"
      }
     },
     {
      "id": "row_download",
      "type": "button",
      "x": 1250,
      "y": 19,
      "w": 240,
      "h": 48,
      "action": "versions.download",
      "param": "{id}",
      "props": {
       "text": "{downloadLabel}",
       "fontSize": 19,
       "bgColor": "{downloadColor}",
       "radius": 8
      }
     }
    ]
   }
  },
  {
   "id": "download_panel",
   "type": "panel",
   "x": 40,
   "y": 772,
   "w": 1520,
   "h": 88,
   "props": {
    "bgColor": "#1a1f2b",
    "radius": 12
   },
   "children": [
    {
     "id": "downloadStatus",
     "type": "label",
     "x": 24,
     "y": 12,
     "w": 1000,
     "h": 60,
     "props": {
      "text": "Pick a version above and press Download. Steam must be running and logged in.",
      "fontSize": 18,
      "color": "#9aa3b5",
      "wrap": true
     }
    },
    {
     "id": "downloadProgress",
     "type": "progress",
     "x": 1040,
     "y": 28,
     "w": 440,
     "h": 30,
     "props": {
      "value": 0,
      "color": "#477cf2",
      "bgColor": "#2a3140",
      "radius": 8,
      "showPercent": false
     }
    }
   ]
  },
  {
   "id": "loginModal",
   "type": "modal",
   "x": 450,
   "y": 200,
   "w": 700,
   "h": 500,
   "props": {
    "title": "One-time Steam login needed",
    "text": "Scan the QR code with the Steam mobile app (Steam Guard) to approve the login \u2014 the download continues automatically once approved. Or log in with your account password in Settings.",
    "buttons": "Log in with password,Use Steam Console,Cancel",
    "onButton": "login.choice"
   }
  }
 ]
}